# Copy this file to .env and fill in the values.

# MongoDB connection string (local install or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/interview-ai

# Long random string used to sign login tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Gemini API key: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

# Optional settings (defaults shown)
# PORT=3000
# CLIENT_URL=http://localhost:5173
# GEMINI_MODEL=gemini-3.8-flash
# PDF_CONCURRENCY=2
# NODE_ENV=development

# Rate limits (defaults shown). Counts are kept in memory per server process.
# PREVIEW_PER_IP_PER_HOUR=3        # landing-page "try it" requests per visitor IP
# PREVIEW_PER_DAY=200              # landing-page "try it" requests from everyone, per day
# GENERATE_PER_USER_PER_HOUR=10    # reports and resume PDFs per logged-in user
# TRUST_PROXY=1                    # set to the number of proxies in front of the app when deployed
